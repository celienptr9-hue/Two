rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Il faut être connecté avec une adresse e-mail vérifiée.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Profils : lisibles par les membres, créés une seule fois par leur propriétaire.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'username', 'usernameLower', 'createdAt'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 50
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-zA-Z0-9_]{3,24}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Identifiants uniques : le nom du document est l'identifiant en minuscules.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;
      allow update, delete: if false;
    }

    // Relations entre deux membres (invitation, puis amitié).
    match /friendships/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'from', 'to', 'status', 'createdAt', 'readAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll([request.auth.uid, request.resource.data.to])
        && pid == pairId(request.auth.uid, request.resource.data.to)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == {}
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to));

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && (
          // Le destinataire accepte l'invitation.
          (resource.data.status == 'pending'
            && resource.data.to == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'accepted')
          ||
          (resource.data.status == 'accepted' && (
            // Aperçu du dernier message.
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId'])
              && request.resource.data.lastSenderId == request.auth.uid
              && request.resource.data.lastMessage is string
              && request.resource.data.lastMessage.size() <= 200
              && request.resource.data.lastMessageAt == request.time)
            ||
            // Marqueur de lecture : chacun ne modifie que le sien.
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
              && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid]))
          ))
        );

      // Refuser ou annuler une invitation en attente.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.status == 'pending';

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && get(/databases/$(database)/documents/friendships/$(pid)).data.status == 'accepted';

        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && get(/databases/$(database)/documents/friendships/$(pid)).data.status == 'accepted'
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
